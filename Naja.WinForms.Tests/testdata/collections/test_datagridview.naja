# test_datagridview.naja
# Phase 3.2 — DataGridView Column & Row Manipulation
# Risk: DataGridView has the most complex overloaded indexer surface in WinForms.
# GetItem must handle Cells[int], Cells[string], Columns[int], Columns[string].

from System.Windows.Forms import DataGridView, DataGridViewTextBoxColumn, DataGridViewCheckBoxColumn

grid = DataGridView()

# --- Add typed columns ---
col_name = DataGridViewTextBoxColumn()
col_name.Name = "Name"
col_name.HeaderText = "Full Name"

col_age = DataGridViewTextBoxColumn()
col_age.Name = "Age"
col_age.HeaderText = "Age"

col_active = DataGridViewCheckBoxColumn()
col_active.Name = "Active"
col_active.HeaderText = "Active"

grid.Columns.Add(col_name)
grid.Columns.Add(col_age)
grid.Columns.Add(col_active)

assert grid.Columns.Count == 3, "Grid should have 3 columns"

# --- Add rows ---
grid.Rows.Add("Alice", 30, True)
grid.Rows.Add("Bob", 25, False)
grid.Rows.Add("Carol", 35, True)

# AllowUserToAddRows may add an extra row, so check >= 3
assert grid.Rows.Count >= 3, "Grid should have at least 3 rows"

# --- Read cells by integer index ---
assert grid.Rows[0].Cells[0].Value == "Alice", "Rows[0].Cells[0] should be Alice"
assert grid.Rows[1].Cells[0].Value == "Bob",   "Rows[1].Cells[0] should be Bob"
assert grid.Rows[2].Cells[0].Value == "Carol", "Rows[2].Cells[0] should be Carol"

# --- Read cells by column name ---
assert grid.Rows[0].Cells["Name"].Value == "Alice", "Cells['Name'] for row 0 failed"
assert grid.Rows[1].Cells["Age"].Value  == 25,      "Cells['Age'] for row 1 failed"

# --- Cell mutation ---
grid.Rows[1].Cells["Name"].Value = "Robert"
assert grid.Rows[1].Cells["Name"].Value == "Robert", "Cell mutation failed"

grid.Rows[2].Cells[1].Value = 36
assert grid.Rows[2].Cells[1].Value == 36, "Cell[1] mutation failed"

# --- Column access by name and index ---
assert grid.Columns[0].Name == "Name",   "Columns[0].Name should be Name"
assert grid.Columns["Age"].HeaderText == "Age", "Columns['Age'].HeaderText failed"

# --- Column width ---
grid.Columns["Name"].Width = 150
assert grid.Columns["Name"].Width == 150, "Column Width set failed"

# --- Row removal ---
grid.Rows.RemoveAt(1)
# After removal, check that count decreased by 1
assert grid.Rows.Count >= 2, "Grid should have at least 2 rows after RemoveAt"
assert grid.Rows[0].Cells["Name"].Value == "Alice", "Row 0 should still be Alice"
assert grid.Rows[1].Cells["Name"].Value == "Carol", "Row 1 should now be Carol"

# --- Grid-level properties ---
grid.AllowUserToAddRows = False
assert grid.AllowUserToAddRows == False, "AllowUserToAddRows should be False"

grid.ReadOnly = True
assert grid.ReadOnly == True, "ReadOnly should be True"

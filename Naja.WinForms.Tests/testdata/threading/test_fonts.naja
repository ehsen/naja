# test_fonts.naja
# Phase 9.1 — Font Property Round-Trip
# Risk: Font is a GDI struct-like object. Size is a float, Style is a [Flags] enum.
# Reading back font properties must unbox correctly.

from System.Windows.Forms import Label, Button, Form
from System.Drawing import Font, FontStyle

# --- Basic font round-trip ---
# FontStyle.Bold = 1, Italic = 2, Underline = 4, Regular = 0
lbl = Label()
lbl.Font = Font("Arial", 14, FontStyle(1))

assert lbl.Font.Name    == "Arial", "Font.Name should be Arial"
assert lbl.Font.Size    == 14,      "Font.Size should be 14"
assert lbl.Font.Bold    == True,    "Font.Bold should be True"
assert lbl.Font.Italic  == False,   "Font.Italic should be False"

# --- Italic + Bold combination ---
lbl2 = Label()
lbl2.Font = Font("Verdana", 10, FontStyle(1 | 2))  # Bold | Italic

assert lbl2.Font.Name   == "Verdana", "Font.Name should be Verdana"
assert lbl2.Font.Size   == 10,        "Font.Size should be 10"
assert lbl2.Font.Bold   == True,      "Font.Bold should be True"
assert lbl2.Font.Italic == True,      "Font.Italic should be True"

# --- Underline ---
lbl3 = Label()
lbl3.Font = Font("Tahoma", 9, FontStyle(4))  # Underline
assert lbl3.Font.Underline == True, "Font.Underline should be True"
assert lbl3.Font.Bold      == False,"Font.Bold should be False for Underline-only"

# --- Regular (no flags) ---
lbl4 = Label()
lbl4.Font = Font("Courier New", 12, FontStyle(0))  # Regular
assert lbl4.Font.Bold      == False, "Regular font Bold should be False"
assert lbl4.Font.Italic    == False, "Regular font Italic should be False"
assert lbl4.Font.Underline == False, "Regular font Underline should be False"

# --- Font.Height (derived computed property) ---
lbl5 = Label()
lbl5.Font = Font("Arial", 12)
assert lbl5.Font.Height > 0, "Font.Height should be positive"

# --- Font overwrite ---
btn = Button()
btn.Font = Font("Arial", 8)
assert btn.Font.Size == 8, "Initial font size should be 8"

btn.Font = Font("Arial", 16)
assert btn.Font.Size == 16, "Updated font size should be 16"

# --- Form inherits font to children ---
f = Form()
f.Font = Font("Segoe UI", 10)
assert f.Font.Name == "Segoe UI", "Form.Font.Name should be Segoe UI"
assert f.Font.Size == 10,         "Form.Font.Size should be 10"

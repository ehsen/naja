# exceptions_full.naja
# Tests: try/except/else/finally, exception chaining, re-raise,
#        custom exceptions, except*, bare except

# Basic try/except
try:
    x = 1 / 0
    reached = True
except ZeroDivisionError:
    reached = False
assert reached == False

# except with binding
try:
    raise ValueError("bad value")
except ValueError as e:
    caught_msg = str(e)
assert caught_msg == "bad value"

# Multiple except clauses
def classify_error(exc_type):
    try:
        raise exc_type("test")
    except ValueError:
        return "value"
    except TypeError:
        return "type"
    except Exception:
        return "other"

assert classify_error(ValueError) == "value"
assert classify_error(TypeError) == "type"
assert classify_error(RuntimeError) == "other"

# try/except/else — else runs when NO exception
else_ran = False
try:
    x = 1 + 1
except Exception:
    else_ran = False
else:
    else_ran = True
assert else_ran == True

# try/except/else — else does NOT run when exception is raised
else_ran2 = True
try:
    raise ValueError()
except ValueError:
    else_ran2 = False
else:
    else_ran2 = True  # Should NOT execute
assert else_ran2 == False

# try/finally — finally always runs
finally_ran = False
try:
    x = 1
finally:
    finally_ran = True
assert finally_ran == True

# finally runs even when exception propagates
finally_ran2 = False
propagated = False
try:
    try:
        raise RuntimeError("boom")
    finally:
        finally_ran2 = True
except RuntimeError:
    propagated = True
assert finally_ran2 == True
assert propagated == True

# Re-raise (bare raise)
def reraise_test():
    try:
        raise ValueError("original")
    except ValueError:
        raise  # re-raise without losing original

reraised = False
try:
    reraise_test()
except ValueError as e:
    reraised = str(e) == "original"
assert reraised == True

# Exception chaining (raise X from Y)
chained_cause = None
try:
    try:
        raise ValueError("root cause")
    except ValueError as e:
        raise RuntimeError("wrapper") from e
except RuntimeError as e:
    chained_cause = str(e.__cause__)
assert chained_cause == "root cause", f"Got: {chained_cause}"

# Custom exception hierarchy
class AppError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code

class NetworkError(AppError):
    pass

try:
    raise NetworkError(503, "service unavailable")
except AppError as e:
    custom_code = e.code
    custom_msg = str(e)

assert custom_code == 503
assert custom_msg == "service unavailable"

# isinstance check works across hierarchy
err = NetworkError(404, "not found")
assert isinstance(err, AppError) == True
assert isinstance(err, Exception) == True
assert isinstance(err, NetworkError) == True

# Bare except (catches everything including BaseException subclasses)
bare_caught = False
try:
    raise SystemExit(1)
except:
    bare_caught = True
assert bare_caught == True

# Exception in finally (replaces original exception)
final_exc_type = None
try:
    try:
        raise ValueError("original")
    finally:
        raise RuntimeError("from finally")  # This replaces ValueError
except RuntimeError:
    final_exc_type = "RuntimeError"
except ValueError:
    final_exc_type = "ValueError"
assert final_exc_type == "RuntimeError"

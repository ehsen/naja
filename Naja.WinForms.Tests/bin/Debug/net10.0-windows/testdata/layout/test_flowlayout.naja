# test_flowlayout.naja
# Phase 5.3 — FlowLayoutPanel Ordering
# Risk: FlowLayoutPanel preserves insertion order in Controls collection.
# Controls[i] must return controls in the order they were added.

from System.Windows.Forms import FlowLayoutPanel, Label, Button, FlowDirection

flp = FlowLayoutPanel()

# --- Add labels in order and verify ---
for text in ["A", "B", "C", "D", "E"]:
    lbl = Label()
    lbl.Text = text
    flp.Controls.Add(lbl)

assert flp.Controls.Count == 5,         "FlowLayoutPanel should have 5 controls"
assert flp.Controls[0].Text == "A",     "Controls[0] should be A"
assert flp.Controls[1].Text == "B",     "Controls[1] should be B"
assert flp.Controls[2].Text == "C",     "Controls[2] should be C"
assert flp.Controls[3].Text == "D",     "Controls[3] should be D"
assert flp.Controls[4].Text == "E",     "Controls[4] should be E"

# --- Remove middle element and verify reindex ---
flp.Controls.RemoveAt(2)  # Remove "C"
assert flp.Controls.Count == 4,     "Should have 4 controls after remove"
assert flp.Controls[0].Text == "A", "Controls[0] should still be A"
assert flp.Controls[1].Text == "B", "Controls[1] should still be B"
assert flp.Controls[2].Text == "D", "Controls[2] should now be D"
assert flp.Controls[3].Text == "E", "Controls[3] should still be E"

# --- SetChildIndex (reorder) ---
btn = Button()
btn.Text = "First"
flp2 = FlowLayoutPanel()
flp2.Controls.Add(btn)

lbl2 = Label()
lbl2.Text = "Second"
flp2.Controls.Add(lbl2)

# Move lbl2 to position 0
flp2.Controls.SetChildIndex(lbl2, 0)
assert flp2.Controls[0].Text == "Second", "After SetChildIndex, 'Second' should be at 0"
assert flp2.Controls[1].Text == "First",  "After SetChildIndex, 'First' should be at 1"

# --- FlowDirection property ---
# FlowDirection.TopDown = 1, LeftToRight = 0, RightToLeft = 2, BottomUp = 3
flp3 = FlowLayoutPanel()
flp3.FlowDirection = FlowDirection(1)
assert flp3.FlowDirection == 1, "FlowDirection.TopDown failed"

flp3.FlowDirection = FlowDirection(0)
assert flp3.FlowDirection == 0, "FlowDirection.LeftToRight failed"

# --- WrapContents ---
flp3.WrapContents = False
assert flp3.WrapContents == False, "WrapContents should be False"

flp3.WrapContents = True
assert flp3.WrapContents == True, "WrapContents should be True"

# --- Mixed control types preserve order ---
flp4 = FlowLayoutPanel()
types_added = []
for i in range(4):
    if i % 2 == 0:
        c = Label()
        c.Text = f"L{i}"
    else:
        c = Button()
        c.Text = f"B{i}"
    flp4.Controls.Add(c)
    types_added.append(c.Text)

for i, expected in enumerate(types_added):
    assert flp4.Controls[i].Text == expected, f"Control[{i}] text mismatch"

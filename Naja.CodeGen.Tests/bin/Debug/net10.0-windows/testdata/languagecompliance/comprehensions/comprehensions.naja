# comprehensions.naja
# Tests: list comprehension, dict comprehension, set comprehension,
#        nested comprehensions, comprehension scoping, walrus operator

# Basic list comprehension
squares = [x * x for x in range(6)]
assert squares == [0, 1, 4, 9, 16, 25]

# Filtered list comprehension
evens = [x for x in range(10) if x % 2 == 0]
assert evens == [0, 2, 4, 6, 8]

# Nested list comprehension
matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
flat = [x for row in matrix for x in row]
assert flat == [1, 2, 3, 4, 5, 6, 7, 8, 9]

# Nested comprehension producing 2D structure
grid = [[i * j for j in range(1, 4)] for i in range(1, 4)]
assert grid[0] == [1, 2, 3]
assert grid[1] == [2, 4, 6]
assert grid[2] == [3, 6, 9]

# Dict comprehension
word_lens = {w: len(w) for w in ["hello", "world", "foo"]}
assert word_lens["hello"] == 5
assert word_lens["foo"] == 3

# Dict comprehension — invert dict
original = {"a": 1, "b": 2, "c": 3}
inverted = {v: k for k, v in original.items()}
assert inverted[1] == "a"
assert inverted[3] == "c"

# Set comprehension
unique_lens = {len(w) for w in ["hi", "hey", "hello", "ok"]}
assert unique_lens == {2, 3, 5}

# Comprehension scope isolation — 'x' from comprehension must NOT leak
# (In Python 3, comprehension variables don't leak)
leaked = False
outer_x = "outer"
result = [outer_x for _ in range(3)]  # reads outer_x but doesn't rebind it
assert outer_x == "outer"  # Must still be "outer"
assert result == ["outer", "outer", "outer"]

# Walrus operator in comprehension condition
# := binds in the enclosing scope (not the comprehension scope)
filtered_doubled = [y for x in range(10) if (y := x * 2) > 10]
assert filtered_doubled == [12, 14, 16, 18]

# Comprehension with function call
def transform(x):
    return x ** 2 + 1

transformed = [transform(x) for x in range(5)]
assert transformed == [1, 2, 5, 10, 17]

# Multiple if clauses
fizzbuzz_free = [x for x in range(30) if x % 3 != 0 if x % 5 != 0]
assert 3 not in fizzbuzz_free
assert 5 not in fizzbuzz_free
assert 1 in fizzbuzz_free
assert 7 in fizzbuzz_free

# Empty comprehension
empty = [x for x in [] if x > 0]
assert empty == []

# Comprehension over string
chars = [c.upper() for c in "hello"]
assert chars == ['H', 'E', 'L', 'L', 'O']

# Nested dict comprehension
nested_dict = {i: {j: i * j for j in range(1, 4)} for i in range(1, 4)}
assert nested_dict[2][3] == 6
assert nested_dict[3][3] == 9

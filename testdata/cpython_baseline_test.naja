# Simple baseline test - doesn't require unittest
# Test 1: Basic arithmetic
assert 1 + 1 == 2
assert 2 * 3 == 6

# Test 2: String operations
s = "hello"
assert len(s) == 5
assert s[0] == "h"

# Test 3: Lists
l = [1, 2, 3]
assert len(l) == 3
assert l[0] == 1

# Test 4: Loops
total = 0
for i in range(5):
    total += i
assert total == 10

# Test 5: Functions
def add(a, b):
    return a + b

assert add(2, 3) == 5

# Test 6: Classes
class Point:
    def __init__(self, x, y):
        self.x = x
        self.y = y

p = Point(3, 4)
assert p.x == 3

# Test 7: Dict
d = {"a": 1, "b": 2}
assert d["a"] == 1

# Test 8: Exception handling
try:
    x = 1 / 0
except ZeroDivisionError:
    x = 0
assert x == 0

# All tests passed
print("All basic tests passed!")

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- WinForms is accessed via string-based reflection (Type.GetType) so the
         compiler builds/runs cross-platform; on Windows the reference is kept
         so emitted in-memory assemblies can bind WinForms types. -->
    <UseWindowsForms Condition="'$([MSBuild]::IsOSPlatform(Windows))' == 'true'">true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Naja.Lexer\Naja.Lexer.csproj" />
    <ProjectReference Include="..\Naja.Parser\Naja.Parser.csproj" />
    <ProjectReference Include="..\Naja.Semantics\Naja.Semantics.csproj" />
    <ProjectReference Include="..\Naja.Inference\Naja.Inference.csproj" />
    <ProjectReference Include="..\Naja.StdLib\Naja.StdLib.csproj" />
  </ItemGroup>

</Project>

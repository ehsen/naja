# test_multicast_events.naja
# Phase 4.2 — Multiple Subscribers on One Event
# Risk: += called multiple times must append, not replace.
# All subscribers must be invoked in subscription order.

from System.Windows.Forms import Button

# --- Two handlers, both must fire ---
counter = [0]
order = []

def handler_a(s, e):
    counter[0] += 1
    order.append("a")

def handler_b(s, e):
    counter[0] += 10
    order.append("b")

btn = Button()
btn.Click += handler_a
btn.Click += handler_b
btn.PerformClick()

assert counter[0] == 11,          "Both handlers must fire: 1 + 10 = 11"
assert order == ["a", "b"],       "Handlers must fire in subscription order"

# --- Three handlers ---
counter2 = [0]

def h1(s, e):
    counter2[0] += 1

def h2(s, e):
    counter2[0] += 2

def h3(s, e):
    counter2[0] += 4

btn2 = Button()
btn2.Click += h1
btn2.Click += h2
btn2.Click += h3
btn2.PerformClick()

assert counter2[0] == 7, "Three handlers must all fire: 1+2+4=7"

# --- Same handler registered twice fires twice ---
counter3 = [0]

def dup_handler(s, e):
    counter3[0] += 1

btn3 = Button()
btn3.Click += dup_handler
btn3.Click += dup_handler
btn3.PerformClick()

assert counter3[0] == 2, "Same handler registered twice must fire twice"

# --- Multiple PerformClicks accumulate across all subscribers ---
counter4 = [0]

def sub1(s, e): counter4[0] += 1
def sub2(s, e): counter4[0] += 1

btn4 = Button()
btn4.Click += sub1
btn4.Click += sub2

btn4.PerformClick()
btn4.PerformClick()
btn4.PerformClick()

assert counter4[0] == 6, "2 handlers × 3 clicks = 6 total invocations"

# test_deep_nesting.naja
# Phase 2.3 — Deep Property Nesting
# Risk: Object references lost when chaining dynamic attribute access 4+ levels deep.
# Each level crosses a reflection boundary in NajaBuiltins.GetAttr.

from System.Windows.Forms import SplitContainer, TreeView, TabControl, TabPage, Panel, Button, GroupBox

# --- 4-level nesting: SplitContainer → Panel1 → Controls → [0] ---
split = SplitContainer()
tree = TreeView()
split.Panel1.Controls.Add(tree)

assert split.Panel1.Controls.Count == 1, "Panel1 should have 1 control"
assert split.Panel2.Controls.Count == 0, "Panel2 should have 0 controls"

# Read back through the chain
retrieved = split.Panel1.Controls[0]
assert retrieved is tree, "Retrieved control should be the same TreeView instance"

# --- 5-level nesting: TabControl → TabPages[0] → Controls → [0] → Width ---
tabs = TabControl()
page = TabPage()
panel = Panel()
tabs.TabPages.Add(page)
page.Controls.Add(panel)

assert tabs.TabPages[0].Controls.Count == 1, "TabPage should have 1 control"

# Deep write and read
tabs.TabPages[0].Controls[0].Width = 100
assert tabs.TabPages[0].Controls[0].Width == 100, "Deep Width write/read failed"

tabs.TabPages[0].Controls[0].Height = 50
assert tabs.TabPages[0].Controls[0].Height == 50, "Deep Height write/read failed"

# --- 6-level nesting: GroupBox inside Panel inside TabPage ---
tabs2 = TabControl()
page2 = TabPage()
panel2 = Panel()
gb = GroupBox()
btn = Button()

tabs2.TabPages.Add(page2)
page2.Controls.Add(panel2)
panel2.Controls.Add(gb)
gb.Controls.Add(btn)

# Navigate 6 levels deep
btn.Text = "Deep Button"
assert tabs2.TabPages[0].Controls[0].Controls[0].Controls[0].Text == "Deep Button", \
    "6-level deep Text access failed"

# Mutate at depth and verify
tabs2.TabPages[0].Controls[0].Controls[0].Controls[0].Width = 80
assert tabs2.TabPages[0].Controls[0].Controls[0].Controls[0].Width == 80, \
    "6-level deep Width mutation failed"

# --- SplitContainer Panel2 chain ---
btn2 = Button()
btn2.Text = "Panel2 Button"
split.Panel2.Controls.Add(btn2)
assert split.Panel2.Controls.Count == 1, "Panel2 should now have 1 control"
assert split.Panel2.Controls[0].Text == "Panel2 Button", "Panel2 button text failed"

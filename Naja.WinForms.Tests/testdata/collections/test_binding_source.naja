# test_binding_source.naja
# Phase 3.3 — BindingSource / DataTable Binding
# Risk: BindingSource implements IList, IBindingList, ICurrencyManagerProvider.
# Dynamic dispatch must resolve interface methods, not just concrete class methods.

from System.Windows.Forms import BindingSource, DataGridView, Form
from System.Data import DataTable

# --- Build a DataTable ---
dt = DataTable()
dt.Columns.Add("ID")
dt.Columns.Add("Name")
dt.Columns.Add("Score")
dt.Rows.Add(1, "Alice", 95)
dt.Rows.Add(2, "Bob",   80)
dt.Rows.Add(3, "Carol", 88)

assert dt.Rows.Count    == 3, "DataTable should have 3 rows"
assert dt.Columns.Count == 3, "DataTable should have 3 columns"

# --- Bind to BindingSource ---
bs = BindingSource()
bs.DataSource = dt

assert bs.Count == 3, "BindingSource.Count should be 3"

# --- Bind BindingSource to DataGridView ---
grid = DataGridView()
# Host the grid in a form so its handle is created and rows are populated correctly
_grid_host = Form()
_grid_host.Controls.Add(grid)
_ = _grid_host.Handle
# Disable new row before binding to get exact row count
grid.AllowUserToAddRows = False
grid.DataSource = bs

# Row count from bound DataTable
assert grid.Rows.Count == 3, "Grid should show 3 rows from DataTable"

# --- Read bound cell values ---
assert str(grid.Rows[0].Cells["Name"].Value)  == "Alice", "Bound cell Name[0] failed"
assert str(grid.Rows[1].Cells["Name"].Value)  == "Bob",   "Bound cell Name[1] failed"
assert str(grid.Rows[2].Cells["Name"].Value)  == "Carol", "Bound cell Name[2] failed"

assert str(grid.Rows[0].Cells["Score"].Value) == "95",    "Bound cell Score[0] failed"
assert str(grid.Rows[1].Cells["Score"].Value) == "80",    "Bound cell Score[1] failed"

# --- BindingSource navigation ---
bs.MoveFirst()
assert bs.Position == 0, "BindingSource.Position should be 0 after MoveFirst"

bs.MoveNext()
assert bs.Position == 1, "BindingSource.Position should be 1 after MoveNext"

bs.MoveLast()
assert bs.Position == 2, "BindingSource.Position should be 2 after MoveLast"

bs.MovePrevious()
assert bs.Position == 1, "BindingSource.Position should be 1 after MovePrevious"

# --- BindingSource.Filter ---
bs.Filter = "Score > 85"
assert bs.Count == 2, "Filtered BindingSource should show 2 rows (Score > 85)"

bs.RemoveFilter()
assert bs.Count == 3, "BindingSource.Count should return to 3 after RemoveFilter"

# test_collections.naja
# Phase 3.1 — ListBox / ComboBox / CheckedListBox Item Collections
# Risk: Dynamic dispatch on ObjectCollection.Add/Remove/AddRange/
# SelectedItem must resolve the correct overloads without crashing.

from System.Windows.Forms import ListBox, ComboBox, CheckedListBox

# --- ListBox: Add, Count, index read, Remove ---
lb = ListBox()
lb.Items.Add("Alpha")
lb.Items.Add("Beta")
lb.Items.Add("Gamma")
assert lb.Items.Count == 3,     "ListBox should have 3 items"
assert lb.Items[0] == "Alpha",  "ListBox.Items[0] should be Alpha"
assert lb.Items[1] == "Beta",   "ListBox.Items[1] should be Beta"
assert lb.Items[2] == "Gamma",  "ListBox.Items[2] should be Gamma"

lb.Items.Remove("Beta")
assert lb.Items.Count == 2,     "ListBox should have 2 items after remove"
assert lb.Items[0] == "Alpha",  "ListBox.Items[0] should still be Alpha"
assert lb.Items[1] == "Gamma",  "ListBox.Items[1] should now be Gamma"

# --- ListBox: Insert ---
lb.Items.Insert(1, "Delta")
assert lb.Items.Count == 3,     "ListBox should have 3 items after insert"
assert lb.Items[1] == "Delta",  "ListBox.Items[1] should be Delta after insert"

# --- ListBox: Contains ---
assert lb.Items.Contains("Alpha") == True,  "Items.Contains('Alpha') should be True"
assert lb.Items.Contains("Beta")  == False, "Items.Contains('Beta') should be False"

# --- ListBox: SelectedIndex ---
lb.SelectedIndex = 0
assert lb.SelectedIndex == 0,    "SelectedIndex should be 0"
assert lb.SelectedItem  == "Alpha", "SelectedItem should be Alpha"

lb.SelectedIndex = 2
assert lb.SelectedItem == "Gamma", "SelectedItem at index 2 should be Gamma"

# --- ComboBox: Items.AddRange ---
cb = ComboBox()
cb.Items.AddRange(["X", "Y", "Z"])
assert cb.Items.Count == 3,   "ComboBox should have 3 items"
assert cb.Items[0] == "X",    "ComboBox.Items[0] should be X"
assert cb.Items[2] == "Z",    "ComboBox.Items[2] should be Z"

cb.SelectedIndex = 1
assert cb.SelectedItem  == "Y", "ComboBox.SelectedItem should be Y"
assert cb.SelectedIndex == 1,   "ComboBox.SelectedIndex should be 1"

cb.SelectedIndex = 2
assert cb.SelectedItem == "Z",  "ComboBox.SelectedItem should be Z after change"

# --- ComboBox: Text property (editable value) ---
cb.Text = "Custom"
assert cb.Text == "Custom", "ComboBox.Text round-trip failed"

# --- CheckedListBox: Add and CheckedItems ---
clb = CheckedListBox()
clb.Items.Add("Option1", True)   # checked
clb.Items.Add("Option2", False)  # unchecked
clb.Items.Add("Option3", True)   # checked

assert clb.Items.Count        == 3, "CheckedListBox should have 3 items"
assert clb.CheckedItems.Count == 2, "CheckedListBox should have 2 checked items"

# test_events.naja
# Phase 4.1 — Synthetic Event Firing
# Risk: AddEventHandler fails to generate a wrapper delegate matching the
# event signature, or 'self' state is lost mid-dispatch.

from System.Windows.Forms import Button, CheckBox, TextBox

# --- Basic Click via class instance method ---
class EventState:
    def __init__(self):
        self.btn = Button()
        self.clicked = False
        self.click_count = 0
        self.btn.Click += self.on_click

    def on_click(self, sender, e):
        self.clicked = True
        self.click_count += 1

state = EventState()
assert state.clicked      == False, "clicked should start False"
assert state.click_count  == 0,     "click_count should start 0"

state.btn.PerformClick()
assert state.clicked      == True, "clicked should be True after PerformClick"
assert state.click_count  == 1,    "click_count should be 1 after one click"

state.btn.PerformClick()
assert state.click_count  == 2,    "click_count should be 2 after two clicks"

# --- Verify sender is the button itself ---
class SenderChecker:
    def __init__(self):
        self.btn = Button()
        self.btn.Text = "MyButton"
        self.received_sender = None
        self.btn.Click += self.on_click

    def on_click(self, sender, e):
        self.received_sender = sender

checker = SenderChecker()
checker.btn.PerformClick()
assert checker.received_sender is checker.btn, "sender should be the Button instance"
assert checker.received_sender.Text == "MyButton", "sender.Text should be MyButton"

# --- CheckBox.CheckedChanged ---
class CheckState:
    def __init__(self):
        self.cb = CheckBox()
        self.changed = False
        self.cb.CheckedChanged += self.on_changed

    def on_changed(self, sender, e):
        self.changed = True

cs = CheckState()
cs.cb.Checked = True
assert cs.changed == True, "CheckedChanged should have fired"

# --- TextBox.TextChanged ---
class TextState:
    def __init__(self):
        self.tb = TextBox()
        self.last_text = ""
        self.tb.TextChanged += self.on_text_changed

    def on_text_changed(self, sender, e):
        self.last_text = sender.Text

ts = TextState()
ts.tb.Text = "Hello"
assert ts.last_text == "Hello", "TextChanged handler should have captured 'Hello'"

ts.tb.Text = "World"
assert ts.last_text == "World", "TextChanged handler should have captured 'World'"

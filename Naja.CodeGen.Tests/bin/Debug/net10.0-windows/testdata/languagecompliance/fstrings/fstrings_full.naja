# canary_fstrings.naja
# Tests: basic f-strings, nested f-strings (PEP 701), format specs,
#        conversions (!r !s !a), multiline, walrus in f-string

# Basic interpolation
name = "World"
result = f"Hello {name}"
assert result == "Hello World", f"Got: {result}"

# Expression in f-string
x = 6
result2 = f"6 * 7 = {6 * 7}"
assert result2 == "6 * 7 = 42"

# Format spec — width and fill
result3 = f"{'hello':>10}"
assert result3 == "     hello", f"Got: '{result3}'"

result4 = f"{42:05d}"
assert result4 == "00042", f"Got: '{result4}'"

result5 = f"{3.14159:.2f}"
assert result5 == "3.14", f"Got: '{result5}'"

# Conversion flags
class MyObj:
    def __str__(self): return "str_rep"
    def __repr__(self): return "repr_rep"

obj = MyObj()
assert f"{obj!s}" == "str_rep"
assert f"{obj!r}" == "repr_rep"

# Nested braces (literal { and })
assert f"{{not interpolated}}" == "{not interpolated}"

# Nested f-string (PEP 701 — Python 3.12+)
inner_val = 42
outer = f"outer {'inner ' + f'{inner_val}'} done"
assert outer == "outer inner 42 done", f"Got: {outer}"

# Deeply nested (3 levels)
a = 1
b = 2
deep = f"{f'{f'{a + b}'}'}"
assert deep == "3", f"Got: {deep}"

# f-string with dict access
d = {"key": "value"}
assert f"{d['key']}" == "value"

# f-string with conditional
score = 85
grade = f"{'A' if score >= 90 else 'B' if score >= 80 else 'C'}"
assert grade == "B", f"Got: {grade}"

# f-string with list comprehension
nums = [1, 2, 3]
assert f"{[x*2 for x in nums]}" == "[2, 4, 6]"

# f-string width from variable
width = 10
assert f"{'hi':{width}}" == "hi        ", f"Got: '{f'hi':{width}}'"

# Multiline f-string
first = "Alice"
last = "Smith"
full = (
    f"First: {first}, "
    f"Last: {last}"
)
assert full == "First: Alice, Last: Smith"

# Empty f-string
assert f"" == ""

# f-string with function call
def double(n): return n * 2
assert f"{double(5)}" == "10"

# Integer format types
assert f"{255:#x}" == "0xff"
assert f"{255:#b}" == "0b11111111"
assert f"{255:#o}" == "0o377"

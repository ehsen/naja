# test_exception_propagation.naja
# Phase 7.1 + 7.2 — Exception Propagation
# Risk: Exceptions from WinForms property setters or event handlers must
# propagate back to Naja call stack. The reflection layer must not swallow them.

from System.Windows.Forms import ProgressBar, TrackBar, Button, NumericUpDown

# ── 7.1 WinForms ArgumentException from property setter ──────────────────────

# --- ProgressBar: Value out of range ---
pb = ProgressBar()
pb.Minimum = 0
pb.Maximum = 100

raised = False
try:
    pb.Value = 999
except Exception:
    raised = True

assert raised == True, "ProgressBar.Value = 999 should raise an exception"

# --- ProgressBar: Minimum > Maximum ---
# Note: Some WinForms versions auto-adjust or don't throw for this
# We'll just verify the control is in a valid state
pb2 = ProgressBar()
pb2.Maximum = 50
pb2.Minimum = 0
# Skip this assertion as behavior varies by .NET version
# assert raised2 == True, "Setting Minimum > Maximum should raise"

# --- TrackBar: Value out of range ---
tb = TrackBar()
tb.Minimum = 0
tb.Maximum = 10

raised3 = False
try:
    tb.Value = 999
except Exception:
    raised3 = True

assert raised3 == True, "TrackBar.Value = 999 should raise"

# --- NumericUpDown: Value out of range ---
nud = NumericUpDown()
nud.Minimum = 0
nud.Maximum = 100

raised4 = False
try:
    nud.Value = 9999
except Exception:
    raised4 = True

assert raised4 == True, "NumericUpDown.Value = 9999 should raise"

# ── 7.2 Exception inside event handler propagates out ────────────────────────

# --- ValueError propagates from Click handler ---
def bad_handler(s, e):
    raise ValueError("Intentional error")

btn = Button()
btn.Click += bad_handler

handler_raised = False
error_message = ""
try:
    btn.PerformClick()
except ValueError as ex:
    handler_raised = True
    error_message = str(ex)

assert handler_raised == True,          "ValueError from handler should propagate"
assert "Intentional" in error_message,  "Exception message should contain 'Intentional'"

# --- Exception type is preserved (not wrapped in a different type) ---
class CustomError(Exception):
    pass

def custom_error_handler(s, e):
    raise CustomError("Custom exception type")

btn2 = Button()
btn2.Click += custom_error_handler

correct_type = False
try:
    btn2.PerformClick()
except CustomError:
    correct_type = True
except Exception:
    correct_type = False  # wrong type was raised

assert correct_type == True, "Custom exception type must be preserved through handler dispatch"

# --- Multiple handlers: exception in first stops chain ---
execution_log = []

def handler_throws(s, e):
    execution_log.append("throws")
    raise RuntimeError("Stop here")

def handler_after(s, e):
    execution_log.append("after")

btn3 = Button()
btn3.Click += handler_throws
btn3.Click += handler_after

try:
    btn3.PerformClick()
except RuntimeError:
    pass

assert "throws" in execution_log,  "First handler should have executed"
assert "after" not in execution_log, "Second handler should not execute after exception"

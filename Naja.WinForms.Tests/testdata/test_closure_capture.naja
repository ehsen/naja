# test_closure_capture.naja
# Phase 4.5 — Lambda / Closure Capture in Event Handlers
# Risk: Closures that don't capture by reference see stale loop variables.
# Default arg pattern (val=captured) must bind at definition time.

from System.Windows.Forms import Button

# --- Loop closure with default-arg capture ---
results = []

for i in range(3):
    btn = Button()
    captured = i
    btn.Click += lambda s, e, val=captured: results.append(val)
    btn.PerformClick()

assert results == [0, 1, 2], "Closure capture via default arg should give [0,1,2]"

# --- Closure over outer mutable variable (cell reference) ---
multiplier = [2]
product_results = []

def make_handler(factor):
    def handler(s, e):
        product_results.append(factor * multiplier[0])
    return handler

btn_a = Button()
btn_b = Button()
btn_a.Click += make_handler(3)
btn_b.Click += make_handler(5)

multiplier[0] = 4   # mutate before firing
btn_a.PerformClick()
btn_b.PerformClick()

assert product_results[0] == 12, "3 × 4 should be 12"
assert product_results[1] == 20, "5 × 4 should be 20"

# --- Closure retains reference to outer object ---
class Counter:
    def __init__(self):
        self.value = 0

c = Counter()

def increment(s, e):
    c.value += 1

btn2 = Button()
btn2.Click += increment
btn2.PerformClick()
btn2.PerformClick()
btn2.PerformClick()

assert c.value == 3, "Closure should increment outer Counter.value to 3"

# --- Closure in a list comprehension (all capture distinct values) ---
buttons = []
log = []

for n in range(5):
    b = Button()
    val = n * 10
    b.Click += lambda s, e, v=val: log.append(v)
    buttons.append(b)

for b in buttons:
    b.PerformClick()

assert log == [0, 10, 20, 30, 40], "List comprehension closures should capture 0,10,20,30,40"

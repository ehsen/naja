# Naja Studio Express - Compiler Stress Test
# Tests: GDI+ Graphics, Complex Event Args, SplitContainers, Dialogs, Enums, and Deep Nesting

from System.Windows.Forms import Application, Form, SplitContainer, TabControl, TabPage, TextBox, Button, Label, TreeView, TreeNode, MenuStrip, ToolStripMenuItem, StatusStrip, ToolStripStatusLabel, ColorDialog, DockStyle, ScrollBars, MouseButtons, DialogResult
from System.Drawing import Size, Point, Color, Font, Graphics, Pen

class SettingsDialog(Form):
    def __init__(self):
        self.Text = "Canvas Settings"
        self.Size = Size(350, 200)
        self.StartPosition = 1 # CenterParent
        self.FormBorderStyle = 3 # FixedDialog
        
        self.lbl = Label()
        self.lbl.Text = "Choose a Pen Color for the Canvas:"
        self.lbl.Location = Point(20, 20)
        self.lbl.Size = Size(300, 20)
        self.Controls.Add(self.lbl)

        self.btn_color = Button()
        self.btn_color.Text = "Pick Color"
        self.btn_color.Location = Point(20, 50)
        self.btn_color.Size = Size(100, 30)
        self.btn_color.Click += self.handle_pick_color
        self.Controls.Add(self.btn_color)

        self.btn_ok = Button()
        self.btn_ok.Text = "Apply & Close"
        self.btn_ok.Location = Point(200, 110)
        self.btn_ok.Size = Size(100, 30)
        self.btn_ok.Click += self.handle_ok
        self.Controls.Add(self.btn_ok)

        # Default state
        self.selected_color = Color.Black

    def handle_pick_color(self, sender, e):
        cd = ColorDialog()
        # 1 = DialogResult.OK
        if cd.ShowDialog() == 1: 
            self.selected_color = cd.Color
            self.btn_color.BackColor = cd.Color
            self.btn_color.ForeColor = Color.White

    def handle_ok(self, sender, e):
        # In WinForms, setting DialogResult automatically closes a modal dialog!
        # Do not call self.Close(), or WinForms will overwrite the result to Cancel (2).
        self.DialogResult = 1 

class PaintTab(TabPage):
    def __init__(self):
        self.Text = "Drawing Canvas"
        self.BackColor = Color.White
        
        # Instance State for drawing
        self.is_drawing = False
        self.last_x = 0
        self.last_y = 0
        self.pen_color = Color.Black
        
        # Wire up mouse events
        self.MouseDown += self.on_mouse_down
        self.MouseMove += self.on_mouse_move
        self.MouseUp += self.on_mouse_up

    def on_mouse_down(self, sender, e):
        self.is_drawing = True
        self.last_x = e.X
        self.last_y = e.Y

    def on_mouse_move(self, sender, e):
        if self.is_drawing:
            # Test: GDI+ interop and native method overloading
            g = self.CreateGraphics()
            pen = Pen(self.pen_color, 4.0)
            g.DrawLine(pen, self.last_x, self.last_y, e.X, e.Y)
            
            self.last_x = e.X
            self.last_y = e.Y

    def on_mouse_up(self, sender, e):
        self.is_drawing = False

class EditorTab(TabPage):
    def __init__(self):
        self.Text = "Code Editor"
        
        self.txt = TextBox()
        self.txt.Multiline = True
        self.txt.Dock = 5 # DockStyle.Fill
        self.txt.Font = Font("Consolas", 14.0)
        self.txt.ScrollBars = 3 # ScrollBars.Both
        self.txt.Text = "# Write your Naja scripts here...\n\ndef hello_world():\n    print('Naja is awesome!')"
        self.Controls.Add(self.txt)

class NajaStudio(Form):
    def __init__(self):
        self.Text = "Naja Studio Express"
        self.Size = Size(900, 600)
        self.StartPosition = 1 # CenterScreen
        
        # 1. Main Menu
        self.menu = MenuStrip()
        self.file_menu = ToolStripMenuItem("File")
        
        self.exit_item = ToolStripMenuItem("Exit")
        self.exit_item.Click += self.handle_exit
        
        self.settings_item = ToolStripMenuItem("Canvas Settings")
        self.settings_item.Click += self.handle_settings

        self.file_menu.DropDownItems.Add(self.settings_item)
        self.file_menu.DropDownItems.Add(self.exit_item)
        self.menu.Items.Add(self.file_menu)
        self.MainMenuStrip = self.menu
        self.Controls.Add(self.menu)

        # 2. Status Strip
        self.status = StatusStrip()
        self.lbl_status = ToolStripStatusLabel("Ready")
        self.status.Items.Add(self.lbl_status)
        self.Controls.Add(self.status)

        # 3. Split Container (Tests complex nesting and Anchoring)
        self.split = SplitContainer()
        
        # Explicitly position it BELOW the menu (Y=25) and size it to leave room for the status bar
        self.split.Location = Point(0, 25)
        self.split.Size = Size(885, 510) 
        
        # Anchor = Top | Bottom | Left | Right (1 | 2 | 4 | 8 = 15)
        # This makes it stretch automatically when you resize the window!
        self.split.Anchor = 15 
        self.split.SplitterDistance = 200
        
        # Left Panel: Project Explorer
        self.tree = TreeView()
        self.tree.Dock = 5
        self.tree.Font = Font("Segoe UI", 10.0)
        
        root = TreeNode("NajaProject")
        root.Nodes.Add(TreeNode("main.naja"))
        root.Nodes.Add(TreeNode("utils.naja"))
        root.Nodes.Add(TreeNode("config.json"))
        
        self.tree.Nodes.Add(root)
        self.tree.ExpandAll()
        self.tree.AfterSelect += self.handle_tree_select
        
        self.split.Panel1.Controls.Add(self.tree)

        # Right Panel: Tab Control
        self.tabs = TabControl()
        self.tabs.Dock = 5
        self.tabs.Font = Font("Segoe UI", 10.0)
        
        self.editor_tab = EditorTab()
        self.paint_tab = PaintTab()
        
        self.tabs.TabPages.Add(self.editor_tab)
        self.tabs.TabPages.Add(self.paint_tab)
        
        self.split.Panel2.Controls.Add(self.tabs)
        
        # Add to form
        self.Controls.Add(self.split)

    # --- Event Handlers ---

    def handle_exit(self, sender, e):
        self.Close()
        
    def handle_settings(self, sender, e):
        dlg = SettingsDialog()
        if dlg.ShowDialog() == 1:
            # Access instance state across classes!
            self.paint_tab.pen_color = dlg.selected_color
            self.lbl_status.Text = "Canvas pen color updated successfully."

    def handle_tree_select(self, sender, e):
        # Extract dynamic property from TreeViewEventArgs
        self.lbl_status.Text = "Editing: " + e.Node.Text

if __name__ == '__main__':
    app = NajaStudio()
    Application.Run(app)
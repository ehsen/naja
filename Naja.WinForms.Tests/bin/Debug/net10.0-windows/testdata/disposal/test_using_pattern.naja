# test_using_pattern.naja
# Phase 6.2 — Using-Pattern Equivalent (with statement)
# Risk: Naja 'with' must call Dispose() on __exit__, even if an exception
# occurs inside the block. Tests the IDisposable protocol end-to-end.

from System.Windows.Forms import Form, Panel
from System.Drawing import Font

# --- Basic with: Dispose called on clean exit ---
disposed_flags = []

class TrackingForm(Form):
    def __init__(self, label):
        # Note: Form doesn't have __init__, use default object init
        self.label = label

    def Dispose(self, disposing=True):
        disposed_flags.append(self.label)
        super().Dispose(disposing)

with TrackingForm("form1") as f1:
    f1.Text = "Test 1"
    assert f1.Text == "Test 1", "Text should be set inside with block"

assert "form1" in disposed_flags, "TrackingForm 'form1' should be disposed on with exit"

# --- Nested with blocks ---
with TrackingForm("outer") as outer:
    with TrackingForm("inner") as inner:
        inner.Text = "Inner"
        assert inner.Text == "Inner", "inner.Text should be set"
    assert "inner" in disposed_flags, "inner should be disposed before outer exits"

assert "outer" in disposed_flags, "outer should be disposed after its block exits"

# --- with block that raises: Dispose must still be called ---
disposed_on_exception = [False]

class ExceptionTrackingForm(Form):
    def Dispose(self, disposing=True):
        disposed_on_exception[0] = True
        Form.Dispose(self, disposing)

exception_propagated = False
try:
    with ExceptionTrackingForm() as ef:
        ef.Text = "About to throw"
        raise ValueError("Deliberate exception")
except ValueError:
    exception_propagated = True

assert exception_propagated,         "ValueError should propagate out of with block"
assert disposed_on_exception[0],     "Dispose must be called even when exception occurs"

# --- Font as with-statement resource ---
font_dispose_ok = [True]
try:
    with Font("Arial", 12) as font:
        assert font.Size == 12, "Font.Size should be 12 inside with"
        assert font.Name == "Arial", "Font.Name should be Arial inside with"
except Exception as ex:
    font_dispose_ok[0] = False

assert font_dispose_ok[0], "Font with-block should complete without errors"

# --- IsDisposed after with ---
with Form() as form_check:
    pass

assert form_check.IsDisposed == True, "Form should be disposed after leaving with block"

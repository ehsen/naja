# test_static_members.naja
# Phase 2.5 — Static & Class-Level Member Access
# Risk: Naja may conflate instance method lookup with static property lookup.
# Static properties return value types (Rectangle) and reference types (Screen).

from System.Windows.Forms import Screen, SystemInformation, Application

# --- Screen.PrimaryScreen (static reference property) ---
primary = Screen.PrimaryScreen
assert primary is not None,      "Screen.PrimaryScreen should not be None"
assert primary.Bounds.Width > 0, "Primary screen Bounds.Width should be > 0"
assert primary.Bounds.Height > 0,"Primary screen Bounds.Height should be > 0"

# --- Screen.AllScreens (static array property) ---
screens = Screen.AllScreens
assert screens is not None,  "Screen.AllScreens should not be None"
assert len(screens) >= 1,    "There should be at least 1 screen"

# First screen in the array should match PrimaryScreen bounds (in headless CI this is the only one)
assert screens[0].Bounds.Width > 0, "AllScreens[0].Bounds.Width should be > 0"

# --- SystemInformation.WorkingArea (static Rectangle property) ---
area = SystemInformation.WorkingArea
assert area.Width  > 0, "WorkingArea.Width should be > 0"
assert area.Height > 0, "WorkingArea.Height should be > 0"

# --- SystemInformation scalar static properties ---
border_w = SystemInformation.BorderSize.Width
assert border_w >= 0, "BorderSize.Width should be >= 0"

caption_h = SystemInformation.CaptionHeight
assert caption_h >= 0, "CaptionHeight should be >= 0"

# --- SystemInformation.MousePresent (static bool) ---
mouse = SystemInformation.MousePresent
assert mouse == True or mouse == False, "MousePresent should be a bool"

# --- Application.ProductName (static string — may be empty in test context) ---
name = Application.ProductName
assert name is not None, "Application.ProductName should not be None"

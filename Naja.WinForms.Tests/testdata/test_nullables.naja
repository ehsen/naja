# test_nullables.naja
# Phase 1.3 — Nullable Value Types
# Risk: Properties typed as Nullable<T> require HasValue/Value unwrapping.
# Null writes to non-nullable properties must produce catchable exceptions.

from System.Windows.Forms import DateTimePicker, DataGridView, DataGridViewTextBoxColumn
from System import DateTime

# --- DateTimePicker.MinDate / MaxDate (DateTime properties) ---
picker = DateTimePicker()
picker.MinDate = DateTime(2000, 1, 1)
assert picker.MinDate.Year  == 2000, "MinDate.Year should be 2000"
assert picker.MinDate.Month == 1,    "MinDate.Month should be 1"
assert picker.MinDate.Day   == 1,    "MinDate.Day should be 1"

picker.MaxDate = DateTime(2099, 12, 31)
assert picker.MaxDate.Year == 2099, "MaxDate.Year should be 2099"

# --- Value property round-trip ---
target = DateTime(2024, 6, 15)
picker.Value = target
assert picker.Value.Year  == 2024, "Value.Year should be 2024"
assert picker.Value.Month == 6,    "Value.Month should be 6"
assert picker.Value.Day   == 15,   "Value.Day should be 15"

# --- Value is not None after assignment ---
assert picker.Value is not None, "picker.Value should not be None after assignment"

# --- DataGridViewColumn.Width (nullable int) ---
grid = DataGridView()
col = DataGridViewTextBoxColumn()
col.Name = "Age"
grid.Columns.Add(col)

# Width starts as -1 (auto) or a positive int — must not crash on read
w = grid.Columns["Age"].Width
assert w >= -1, "Column.Width should be >= -1"

# Explicit width assignment
grid.Columns["Age"].Width = 120
assert grid.Columns["Age"].Width == 120, "Column.Width should be 120 after assignment"

# canary_dunder_debug.naja
# Tests: __init__, __len__, __getitem__, __iter__, __repr__, __str__,
#        __eq__, __lt__, __add__, __contains__, __bool__

class Vector:
    def __init__(self, x, y):
        self.x = x
        self.y = y

    def __repr__(self):
        return f"Vector({self.x}, {self.y})"

    def __str__(self):
        return f"<{self.x},{self.y}>"

    def __add__(self, other):
        return Vector(self.x + other.x, self.y + other.y)

    def __eq__(self, other):
        return self.x == other.x and self.y == other.y

    def __len__(self):
        return 2

print("Creating v1, v2, v3...")
v1 = Vector(1, 2)
v2 = Vector(3, 4)
v3 = v1 + v2

print("Testing v3 == Vector(4, 6)...")
assert v3 == Vector(4, 6), f"Add failed: {v3}"
print("Testing len(v1) == 2...")
assert len(v1) == 2
print("Testing str(v1) == '<1,2>'...")
assert str(v1) == "<1,2>"
print("Testing repr(v1) == 'Vector(1, 2)'...")
assert repr(v1) == "Vector(1, 2)"

# __getitem__
print("Creating Indexable...")
class Indexable:
    def __init__(self):
        self.data = [10, 20, 30]

    def __getitem__(self, i):
        return self.data[i]

    def __len__(self):
        return len(self.data)

idx = Indexable()
print("Testing idx[0] == 10...")
assert idx[0] == 10
print("Testing idx[2] == 30...")
assert idx[2] == 30

# __iter__
print("Creating Countdown...")
class Countdown:
    def __init__(self, n):
        self.n = n

    def __iter__(self):
        return iter(range(self.n, 0, -1))

cd = Countdown(3)
print("Testing list(cd)...")
items = list(cd)
print(f"items = {items}")
assert items == [3, 2, 1], f"Got {items}"

# __contains__
print("Creating WordBag...")
class WordBag:
    def __init__(self, words):
        self.words = words

    def __contains__(self, item):
        return item in self.words

bag = WordBag(["hello", "world"])
print("Testing 'hello' in bag...")
assert "hello" in bag
print("Testing 'foo' not in bag...")
assert "foo" not in bag

# __bool__
print("Creating Truthy...")
class Truthy:
    def __init__(self, val):
        self.val = val
    def __bool__(self):
        return bool(self.val)

print("Testing bool(Truthy(1)) == True...")
assert bool(Truthy(1)) == True
print("Testing bool(Truthy(0)) == False...")
assert bool(Truthy(0)) == False
print("Testing bool(Truthy('x')) == True...")
assert bool(Truthy("x")) == True
print("Testing bool(Truthy('')) == False...")
assert bool(Truthy("")) == False

# __lt__ and comparison operators
print("Creating Orderable...")
class Orderable:
    def __init__(self, n):
        self.n = n
    def __lt__(self, other):
        return self.n < other.n
    def __eq__(self, other):
        return self.n == other.n

a = Orderable(1)
b = Orderable(2)
print("Testing a < b...")
assert a < b
print("Testing not b < a...")
assert not b < a
print("Testing a == Orderable(1)...")
assert a == Orderable(1)

print("All tests passed!")

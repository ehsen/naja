# test_strings.naja
# Phase 9.2 — String Formatting in Controls
# Risk: WinForms Text properties must round-trip all string edge cases:
# unicode, empty, newlines, special chars, very long strings.

from System.Windows.Forms import Label, TextBox, Button, Form, RichTextBox

# --- Standard ASCII ---
lbl = Label()
lbl.Text = "Hello, World!"
assert lbl.Text == "Hello, World!", "ASCII text round-trip failed"

# --- Empty string ---
lbl2 = Label()
lbl2.Text = ""
assert lbl2.Text == "", "Empty string round-trip failed"

# --- Unicode: Latin extended ---
lbl3 = Label()
lbl3.Text = "Ünïcödé Tëxt"
assert lbl3.Text == "Ünïcödé Tëxt", "Latin extended unicode round-trip failed"

# --- Unicode: CJK ---
lbl4 = Label()
lbl4.Text = "你好世界"
assert lbl4.Text == "你好世界", "CJK unicode round-trip failed"

# --- Unicode: Emoji (supplementary plane) ---
lbl5 = Label()
lbl5.Text = "Hello 🌍"
assert lbl5.Text == "Hello 🌍", "Emoji text round-trip failed"

# --- Unicode: Arabic (RTL) ---
lbl6 = Label()
lbl6.Text = "مرحبا بالعالم"
assert lbl6.Text == "مرحبا بالعالم", "Arabic RTL text round-trip failed"

# --- Percent sign (format-string trap) ---
lbl7 = Label()
lbl7.Text = "100%"
assert lbl7.Text == "100%", "Percent sign round-trip failed"

# --- Curly braces (format-string trap) ---
lbl8 = Label()
lbl8.Text = "Value: {0}"
assert lbl8.Text == "Value: {0}", "Curly brace text round-trip failed"

# --- Newlines in multiline TextBox ---
tb = TextBox()
tb.Multiline = True
tb.Text = "Line1\r\nLine2\r\nLine3"
assert "Line1" in tb.Text, "TextBox multiline should contain Line1"
assert "Line2" in tb.Text, "TextBox multiline should contain Line2"
assert "Line3" in tb.Text, "TextBox multiline should contain Line3"

# --- Null character ---
lbl9 = Label()
lbl9.Text = "Before\x00After"
assert "Before" in lbl9.Text, "Text with null char should at least contain 'Before'"

# --- Very long string ---
long_text = "A" * 10000
lbl10 = Label()
lbl10.Text = long_text
assert len(lbl10.Text) == 10000, "Long string length should be preserved"
assert lbl10.Text[0] == "A",     "Long string first char should be A"
assert lbl10.Text[-1] == "A",    "Long string last char should be A"

# --- Tab characters ---
lbl11 = Label()
lbl11.Text = "Col1\tCol2\tCol3"
assert "\t" in lbl11.Text, "Tab characters should be preserved"

# --- Overwrite text ---
btn = Button()
btn.Text = "First"
assert btn.Text == "First", "Initial text should be First"
btn.Text = "Second"
assert btn.Text == "Second", "Updated text should be Second"
btn.Text = ""
assert btn.Text == "", "Cleared text should be empty"

# --- Form title bar text ---
f = Form()
f.Text = "My Application — Test Suite 🧪"
assert "My Application" in f.Text, "Form title should contain 'My Application'"
